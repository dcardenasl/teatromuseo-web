#--------------------------------------------------------------------
# REQUIRED CONFIGURATION
# Must be configured before the application can run
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# Environment & Base URL (REQUIRED)
#--------------------------------------------------------------------

CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8184/'
app.appTimezone = 'America/Santiago'
app.defaultLocale = 'es'
# Enable these in production behind HTTPS.
# app.forceGlobalSecureRequests = true
# app.CSPEnabled = true
# CSP defaults stay permissive for seeded demo media so remote images,
# documents, and video embeds keep working during project bootstrap.
# Tighten them later by overriding these values in .env:
# CSP_IMAGE_SRC = 'self http: https: data:'
# CSP_FRAME_SRC = 'self http: https:'
# CSP_MEDIA_SRC = 'self http: https:'
# CSP_OBJECT_SRC = 'self http: https:'

#--------------------------------------------------------------------
# Public-read API client (REQUIRED)
# Public content reads go through one BFF, which owns the read-only connections
# to CMS, Catalog, Event and Hub file data.
#--------------------------------------------------------------------

BFF_API_BASE_URL = http://localhost:8188

# Analytics is a separate best-effort write queue and must not use the BFF's
# read-only surface. This endpoint remains on CMS because tracking is a write.
WEB_TRACKING_API_BASE_URL = http://localhost:8190
TEAM_MEDIA_BASE_URL = https://teatromuseo.cl/images/team/
# Never deploy the placeholder — create a real key registered in the BFF.
WEB_API_KEY = 'CHANGE_ME'
BFF_API_KEY = 'CHANGE_ME'

# Keep beta/preview deployments out of search indexes. Set to
# "index, follow" only when this application becomes canonical.
WEB_DEFAULT_META_ROBOTS = 'noindex, nofollow'

# Timeout (seconds) for Domain API requests. Production recommendation: 5.
# WEB_API_TIMEOUT = 2
# Connection timeout (seconds). Keep this shorter than WEB_API_TIMEOUT so a
# network problem does not hold a shared-hosting worker for the full deadline.
# WEB_API_CONNECT_TIMEOUT = 1

# Enable WebApiClient request telemetry in beta/staging. This raises the
# application log threshold so [web-api] events include cache and timing data.
# Keep disabled on production unless an APM/log collector is configured.
# WEB_API_TELEMETRY = false

# TTL (seconds) of the stale-cache copy served when the Domain API is down
# (transport failure or 5xx). Default: 86400 (24 h). Set to 0 to disable.
# WEB_API_STALE_TTL = 86400
# Keep at 1 until QA-03 confirms the provider budget. Beta may be calibrated
# with 2 explicitly; production clamps this value to a ceiling of 2.

# Page-view tracking is best effort. Disable it on constrained hosting unless
# a separate bounded event-ingestion path is available.
# WEB_TRACKING_ENABLED = false
# Queue directory is relative to the project root unless absolute. The
# default is writable/analytics-queue. The cron command flushes it later.
# WEB_TRACKING_QUEUE_DIR = writable/analytics-queue
# WEB_TRACKING_QUEUE_BATCH_SIZE = 100
# WEB_TRACKING_QUEUE_MAX_ATTEMPTS = 5
# WEB_TRACKING_QUEUE_TIMEOUT_MS = 5000
# WEB_TRACKING_QUEUE_CONNECT_TIMEOUT_MS = 1000

# Full rendered HTML response cache in production (seconds). Set to 0 to
# disable. Preview requests are never cached. Default: 300.
# WEB_PAGE_CACHE_TTL = 300

# Public pages always use the BFF page-resolve contract. Production should use
# shared snapshots for the explicit manifest; synchronous mode is for local
# development and preview only. Keep fallback disabled in production so a
# missing snapshot is visible as an operational failure instead of silently
# reintroducing a live composition request per visitor.
# WEB_PAGE_DELIVERY_MODE = snapshot
# WEB_PAGE_DELIVERY_ALLOW_SYNC_FALLBACK = false
# WEB_PAGE_SNAPSHOT_DIR = /absolute/shared/path/page-snapshots
# Explicit acknowledgement that the directory is shared by every web worker.
# Leave false for local/single-worker development; the app then uses a null
# snapshot backend instead of pretending a private filesystem is shared.
# WEB_PAGE_SNAPSHOT_SHARED = false
# WEB_PAGE_SNAPSHOT_TTL = 300
# WEB_PAGE_SNAPSHOT_STALE_TTL = 86400
# WEB_PAGE_SNAPSHOT_MAX_BYTES = 5242880
# WEB_PAGE_SNAPSHOT_RETENTION = 3
# WEB_PAGE_SNAPSHOT_LOCK_TTL = 900
# WEB_PAGE_SNAPSHOT_COMPRESSION = gzip
# Stable route keys are locale-aware: home, events, catalog. Add CMS slugs
# explicitly (for example: home,events,catalog,nosotros) after parity QA.
# WEB_PAGE_SNAPSHOT_MANIFEST_ROUTES = home,events,catalog

#--------------------------------------------------------------------
# Cache invalidation webhook (REQUIRED for the /cache/invalidate endpoint)
# Shared secret checked via hash_equals() against the X-Invalidate-Key header.
# MANDATORY in production: while empty, the endpoint refuses every request
# with HTTP 500, so nobody can flush the cache remotely. Generate a random
# value, e.g.: php -r "echo bin2hex(random_bytes(32));"
#--------------------------------------------------------------------

CACHE_INVALIDATE_KEY = ''

# Protected public-read diagnostics endpoint. Leave empty to disable it.
# Send the value as X-Diagnostics-Key; never log or expose this key.
PUBLIC_READ_DIAGNOSTICS_KEY = ''

# Optional shared secret for the server-to-server /blocks/preview endpoint
# (called only by the Admin panel's block editor). Checked via hash_equals()
# against the X-Block-Preview-Key header. Recommended in production — while
# empty, the endpoint stays open (mitigated only by throttle:10,60), which
# preserves the pre-2026-08-12 behavior. Set the SAME value here and in
# teatromuseo-admin's BLOCK_PREVIEW_KEY to enforce it end to end. Generate a
# random value, e.g.: php -r "echo bin2hex(random_bytes(32));"
BLOCK_PREVIEW_KEY = ''

#--------------------------------------------------------------------
# ENCRYPTION (REQUIRED)
# Generate a key using: php spark key:generate
#--------------------------------------------------------------------

encryption.key = ''

#--------------------------------------------------------------------
# OPTIONAL CONFIGURATION
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# Cache backend
#--------------------------------------------------------------------

# CI4 cache handler for API response caching. Default: file. APCu is process
# local and is never used as the authoritative public snapshot backend.
# Use 'redis' for load-balanced deployments.
# cache.handler = file

#--------------------------------------------------------------------
# Session / Cookies
#--------------------------------------------------------------------

# Default: FileHandler (suitable for single-server deployments)
# session.driver = 'CodeIgniter\\Session\\Handlers\\FileHandler'
# session.savePath = '/absolute/path/to/writable/session'

# For horizontal scaling (load-balanced clusters):
# session.driver = 'CodeIgniter\\Session\\Handlers\\RedisHandler'
# session.savePath = 'tcp://redis:6379'

#--------------------------------------------------------------------
# Forms — reCAPTCHA (OPTIONAL)
#--------------------------------------------------------------------

# RECAPTCHA_SITE_KEY = ''
# RECAPTCHA_SECRET_KEY = ''

#--------------------------------------------------------------------
# Site branding (OPTIONAL)
#--------------------------------------------------------------------

# site_logo_url = https://example.com/logo.png
# site_footer_logo_url = https://example.com/footer-logo.png
