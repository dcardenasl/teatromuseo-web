#--------------------------------------------------------------------
# REQUIRED CONFIGURATION
# Must be configured before the application can run
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# Environment & Base URL (REQUIRED)
#--------------------------------------------------------------------

CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8184/'
app.defaultLocale = 'es'
# Enable these in production behind HTTPS.
# app.forceGlobalSecureRequests = true
# app.CSPEnabled = true
# CSP defaults stay permissive for seeded demo media so remote images,
# documents, and video embeds keep working during project bootstrap.
# Tighten them later by overriding these values in .env:
# CSP_IMAGE_SRC = 'self http: https: data:'
# CSP_FRAME_SRC = 'self http: https:'
# CSP_MEDIA_SRC = 'self http: https:'
# CSP_OBJECT_SRC = 'self http: https:'

#--------------------------------------------------------------------
# Domain API Clients (REQUIRED)
# This site talks to THREE separate domain apps, each with its own base URL
# and its own registered copy of WEB_API_KEY (create the key in each domain's
# admin panel — it is not automatically shared between domains):
#   - CMS content (pages, collections, entries, blocks, menus, settings)
#   - Catalog domain (museum collection items, categories, techniques)
#   - Event domain (events/cartelera, venues, ticket types)
# Leaving CATALOG_API_BASE_URL / EVENT_API_BASE_URL unset silently falls back
# to localhost (app/Config/App.php), which is unreachable in production — the
# affected pages don't error, they just render as empty (e.g. /cartelera,
# /museo/coleccion), which is easy to miss in a smoke test that only checks
# CMS-backed pages like the home page.
#--------------------------------------------------------------------

WEB_API_BASE_URL = http://localhost:8190
CATALOG_API_BASE_URL = http://localhost:8191
EVENT_API_BASE_URL = http://localhost:8193
TEAM_MEDIA_BASE_URL = https://teatromuseo.cl/images/team/
# Never deploy the placeholder — create a real key in each domain's admin panel.
WEB_API_KEY = 'CHANGE_ME'

# Timeout (seconds) for Domain API requests. Production recommendation: 5.
# WEB_API_TIMEOUT = 2

# Enable WebApiClient request telemetry in beta/staging. This raises the
# application log threshold so [web-api] events include cache and timing data.
# Keep disabled on production unless an APM/log collector is configured.
# WEB_API_TELEMETRY = false

# TTL (seconds) of the stale-cache copy served when the Domain API is down
# (transport failure or 5xx). Default: 86400 (24 h). Set to 0 to disable.
# WEB_API_STALE_TTL = 86400
# WEB_API_MAX_PARALLEL_REQUESTS = 1

# Full rendered HTML response cache in production (seconds). Set to 0 to
# disable. Preview requests are never cached. Default: 300.
# WEB_PAGE_CACHE_TTL = 300

#--------------------------------------------------------------------
# Cache invalidation webhook (REQUIRED for the /cache/invalidate endpoint)
# Shared secret checked via hash_equals() against the X-Invalidate-Key header.
# MANDATORY in production: while empty, the endpoint refuses every request
# with HTTP 500, so nobody can flush the cache remotely. Generate a random
# value, e.g.: php -r "echo bin2hex(random_bytes(32));"
#--------------------------------------------------------------------

CACHE_INVALIDATE_KEY = ''

#--------------------------------------------------------------------
# ENCRYPTION (REQUIRED)
# Generate a key using: php spark key:generate
#--------------------------------------------------------------------

encryption.key = ''

#--------------------------------------------------------------------
# OPTIONAL CONFIGURATION
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# Cache backend
#--------------------------------------------------------------------

# CI4 cache handler for API response caching. Default: file.
# Use 'redis' for load-balanced deployments.
# cache.handler = file

#--------------------------------------------------------------------
# Session / Cookies
#--------------------------------------------------------------------

# Default: FileHandler (suitable for single-server deployments)
# session.driver = 'CodeIgniter\\Session\\Handlers\\FileHandler'
# session.savePath = '/absolute/path/to/writable/session'

# For horizontal scaling (load-balanced clusters):
# session.driver = 'CodeIgniter\\Session\\Handlers\\RedisHandler'
# session.savePath = 'tcp://redis:6379'

#--------------------------------------------------------------------
# Forms — reCAPTCHA (OPTIONAL)
#--------------------------------------------------------------------

# RECAPTCHA_SITE_KEY = ''
# RECAPTCHA_SECRET_KEY = ''

#--------------------------------------------------------------------
# Site branding (OPTIONAL)
#--------------------------------------------------------------------

# site_logo_url = https://example.com/logo.png
# site_footer_logo_url = https://example.com/footer-logo.png

#--------------------------------------------------------------------
# Social media links (OPTIONAL)
#--------------------------------------------------------------------
# Profile URLs displayed in the footer. Leave empty to hide a network.
# `php spark social:sync` pushes these values into the Domain CMS settings.

# SOCIAL_FACEBOOK =
# SOCIAL_INSTAGRAM =
# SOCIAL_YOUTUBE =
