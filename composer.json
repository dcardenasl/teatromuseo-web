{
    "name": "ci4/website-builder-web",
    "description": "Public CodeIgniter 4 website frontend for ci4-website-builder-domain.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "ezyang/htmlpurifier": "^4.17"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "friendsofphp/php-cs-fixer": "^3.95",
        "mikey179/vfsstream": "^1.6",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "chmod +x pre-commit",
            "cp pre-commit .git/hooks/pre-commit",
            "chmod +x pre-push",
            "cp pre-push .git/hooks/pre-push"
        ],
        "post-update-cmd": [
            "chmod +x pre-commit",
            "cp pre-commit .git/hooks/pre-commit",
            "chmod +x pre-push",
            "cp pre-push .git/hooks/pre-push"
        ],
        "test": "phpunit --no-coverage",
        "test:unit": "phpunit --testsuite=Unit --no-coverage",
        "test:feature": "phpunit --testsuite=Feature --no-coverage",
        "test:contract": "phpunit --testsuite=Contract --no-coverage",
        "test:contract:integration": "RUN_CONTRACT_TESTS=1 phpunit --testsuite=Contract --no-coverage",
        "test:dynamic": "phpunit tests/unit tests/feature --no-coverage",
        "test:fixture-policy": "php scripts/check-test-fixture-policy.php",
        "test:e2e": "phpunit --testsuite=E2E --no-coverage",
        "test:coverage": "phpunit",
        "coverage:check": "php scripts/check-coverage.php 60 tests/coverage/clover.xml",
        "test:seo": "phpunit tests/feature/SeoMarkupTest.php --no-coverage",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff --sequential",
        "quality": [
            "@format:check",
            "@analyse",
            "@i18n-check",
            "@test:fixture-policy",
            "@test"
        ],
        "i18n-check": "php scripts/i18n-check.php",
        "cs-fix": "@format",
        "cs-check": "@format:check",
        "phpstan": "@analyse"
    }
}
